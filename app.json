{
  "expo": {
    "name": "PastPins",
    "slug": "past-pins",
    "version": "1.0.0",
    "platforms": [
      "ios"
    ],
    "scheme": "past-pins",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
