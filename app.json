{
  "expo": {
    "name": "PastPins",
    "slug": "past-pins",
    "version": "1.0.0",
    "platforms": [
      "ios"
    ],
    "scheme": "past-pins",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "io.github.kkd16.pastpins",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleLocalizations": [
          "en"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "cb45cd45-ff76-42b1-878a-a548b611d249"
      }
    },
    "owner": "kyle.deliyannides"
  }
}
