{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "bun": "1.4.2"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    },
    "screenshots": {
      "extends": "production",
      "autoIncrement": false,
      "withoutCredentials": true,
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6822133116"
      }
    }
  }
}
